      "step": "read",
      "in": 23,
      "retained": 23,
      "corrected": 0,
      "removed": 0,
      "note": "days a PAGASA wind signal was up over Metro Manila, from news reports (incomplete); every other day is written as signal 0; no storm surge height was found for any day"
    },
    {
      "dataset": "weather: daily features",
      "step": "merge and correct",
      "in": 5392,
      "retained": 5392,
      "corrected": 1175,
      "removed": 0,
      "note": "one row for every day of the period; corrected = a day without GSMaP rainfall filled with ERA5's total, or a wettest hour (ERA5) above the day's total (GSMaP) lowered to that total",
      "detail": {
        "filled_from_era5": 92,
        "wettest_hour_capped": 1083
      }
    },
    {
      "dataset": "incidents: fire (Asia Fire News)",
      "step": "read",
      "in": 131,
      "retained": 131,
      "corrected": 0,
      "removed": 0,
      "note": "every report in the archive that names Manila"
    },
    {
      "dataset": "incidents: fire (Asia Fire News)",
      "step": "clean",
      "in": 131,
      "retained": 130,
      "corrected": 0,
      "removed": 1,
      "note": "removed: no usable date, hazard, or coordinates; the same fire reported twice (same day, within 300 m)",
      "detail": {
        "unusable": 0,
        "duplicates": 1
      }
    },
    {
      "dataset": "incidents: fire (Asia Fire News)",
      "step": "geocode",
      "in": 130,
      "retained": 130,
      "corrected": 0,
      "removed": 0,
      "note": "each report was placed by the place it names (locate_fire_news.py): its barangay, its street on OpenStreetMap, or only its district's centre; here each point is matched to the barangay boundary it falls in. District-only points stay for the LSTM (a fire happened that day) but not for the KDE (the point is not where the fire was)",
      "detail": {
        "placed_by": {
          "district": 64,
          "street": 43,
          "barangay": 23
        },
        "outside_the_city": 0
      }
    },
    {
      "dataset": "incidents: fire (Asia Fire News)",
      "step": "time-align",
      "in": 130,
      "retained": 130,
      "corrected": 0,
      "removed": 0,
      "note": "kept only the days the archive covers (2012-02 to 2016-12 and 2019-01 to 2025-01; it has no reports for 2017 and 2018); the date is the report's, which is the day of the fire or the day after"
    },
    {
      "dataset": "incidents: flood (MMDA flood reports in the news)",
      "step": "read",
      "in": 75,
      "retained": 75,
      "corrected": 0,
      "removed": 0,
      "note": "56 flooded corners on MMDA's lists (2021 to 2026) and 19 flood days with City of Manila streets named but no single point (2012 to 2024)"
    },
    {
      "dataset": "incidents: flood (MMDA flood reports in the news)",
      "step": "clean",
      "in": 75,
      "retained": 67,
      "corrected": 0,
      "removed": 8,
      "note": "removed: no usable date or coordinates; the same corner twice on one day (within 300 m)",
      "detail": {
        "unusable": 0,
        "duplicates": 8
      }
    },
    {
      "dataset": "incidents: flood (MMDA flood reports in the news)",
      "step": "geocode",
      "in": 67,
      "retained": 66,
      "corrected": 0,
      "removed": 1,
      "note": "each corner was placed where its two streets meet on OpenStreetMap (locate_flood_reports.py) and matched to its barangay here; the flood days without one point stay for the LSTM only",
      "detail": {
        "placed_at_a_corner": 47,
        "no_single_point": 19,
        "outside_the_city": 1
      }
    },
    {
      "dataset": "incidents: flood (MMDA flood reports in the news)",
      "step": "time-align",
      "in": 66,
      "retained": 66,
      "corrected": 0,
      "removed": 0,
      "note": "a flood day already on the corner lists is counted once (corrected: merged into those corners); kept the weather period"
    },
    {
      "dataset": "incidents: storm surge",
      "step": "read",
      "in": 0,
      "retained": 0,
      "corrected": 0,
      "removed": 0,
      "note": "no storm surge incident in Manila was found in the news or in DROMIC for these years: the LSTM cannot be trained for it; its map comes from UP NOAH's storm surge zones (noah_barangays.py) instead"
    }
