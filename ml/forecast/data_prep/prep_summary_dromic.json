{
  "variant": "dromic",
  "data": "PUBLIC RECORDS standing in for PAGASA's and MDRRMD's: GSMaP (JAXA) and ERA5 (Open-Meteo) weather, signals from news and IBTrACS storm tracks, fires from DSWD DROMIC (fires that affected families), floods from DSWD DROMIC events and MMDA lists in the news. Real, but incomplete; see docs/OBJECTIVE-2-RESULTS.md",
  "window_days": 14,
  "horizon_days": 3,
  "split": [
    0.7,
    0.15,
    0.15
  ],
  "features": [
    "rainfall_total_mm",
    "rainfall_max_hourly_mm",
    "typhoon_signal",
    "max_wind_kph",
    "storm_surge_m",
    "prior_day_incidents"
  ],
  "period": [
    "2012-01-01",
    "2026-10-05"
  ],
  "steps": [
    {
      "dataset": "weather: GSMaP rainfall",
      "step": "read",
      "in": 5413,
      "retained": 5333,
      "corrected": 0,
      "removed": 80,
      "note": "days asked for 2012-01-01 to 2026-10-26; JAXA has no file for the removed days"
    },
    {
      "dataset": "weather: GSMaP rainfall",
      "step": "clean",
      "in": 5333,
      "retained": 5318,
      "corrected": 0,
      "removed": 15,
      "note": "removed: a cell with no reading (JAXA's no-data value) or a value outside 0 to 1500 mm",
      "detail": {
        "no_reading": 15,
        "out_of_range": 0
      }
    },
    {
      "dataset": "weather: GSMaP rainfall",
      "step": "time-align",
      "in": 5318,
      "retained": 5318,
      "corrected": 0,
      "removed": 0,
      "note": "GSMaP's day runs 00:00 to 23:59 UTC = 08:00 to 07:59 Manila time (PAGASA's 8 AM rainfall day); kept as the Manila date it starts on (16 of its 24 hours)"
    },
    {
      "dataset": "weather: GSMaP rainfall",
      "step": "keep the period",
      "in": 5318,
      "retained": 5300,
      "corrected": 0,
      "removed": 18,
      "note": "2012-01-01 to 2026-10-05, the days every weather source covers"
    },
    {
      "dataset": "weather: ERA5 (Open-Meteo)",
      "step": "read and clean",
      "in": 5392,
      "retained": 5392,
      "corrected": 0,
      "removed": 0,
      "note": "already in Manila days (Asia/Manila); wettest hour and highest wind of each day"
    },
    {
      "dataset": "weather: typhoon signals",
      "step": "read",
      "in": 23,
      "retained": 23,
      "corrected": 0,
      "removed": 0,
      "note": "days a PAGASA wind signal was up over Metro Manila, from news reports (incomplete); every other day is written as signal 0; no storm surge height was found for any day"
    },
    {
      "dataset": "weather: typhoon signals",
      "step": "estimate from storm tracks",
      "in": 260,
      "retained": 97,
      "corrected": 76,
      "removed": 0,
      "note": "NOAA IBTrACS tracks give an estimated signal for every day (storm_signal.py; it matches 19 of the 23 news days on the day); each day keeps the higher of the news signal and the estimate. corrected = days given a signal the news did not report, or a higher one",
      "detail": {
        "days_added": 74,
        "days_raised": 2
      }
    },
    {
      "dataset": "weather: daily features",
      "step": "merge and correct",
      "in": 5392,
      "retained": 5392,
      "corrected": 1175,
      "removed": 0,
      "note": "one row for every day of the period; corrected = a day without GSMaP rainfall filled with ERA5's total, or a wettest hour (ERA5) above the day's total (GSMaP) lowered to that total",
      "detail": {
        "filled_from_era5": 92,
        "wettest_hour_capped": 1083
      }
    },
    {
      "dataset": "incidents: fire (DSWD DROMIC)",
      "step": "read",
      "in": 190,
      "retained": 190,
      "corrected": 0,
      "removed": 0,
      "note": "every DROMIC report of a fire in the City of Manila (fires that affected families), 2017 to 2026"
    },
    {
      "dataset": "incidents: fire (DSWD DROMIC)",
      "step": "clean",
      "in": 190,
      "retained": 186,
      "corrected": 0,
      "removed": 4,
      "note": "removed: no date; the same fire twice (same day, within 300 m)",
      "detail": {
        "unusable": 1,
        "duplicates": 3
      }
    },
    {
      "dataset": "incidents: fire (DSWD DROMIC)",
      "step": "geocode",
      "in": 186,
      "retained": 186,
      "corrected": 0,
      "removed": 0,
      "note": "placed by place_fires.py: a named barangay at its centre; a TXTFIRE street found on OpenStreetMap and kept only inside its own district; else the district's centre. Barangay and street positions go to the KDE; district and city positions only tell the LSTM a fire happened that day",
      "detail": {
        "placed_by": {
          "district": 21,
          "barangay": 164,
          "city": 1
        },
        "placed_by_method": {
          "district centre": 21,
          "barangay centre": 164,
          "City Hall (no place given)": 1
        }
      }
    },
    {
      "dataset": "incidents: fire (DSWD DROMIC)",
      "step": "time-align",
      "in": 186,
      "retained": 182,
      "corrected": 0,
      "removed": 4,
      "note": "kept the days this source covers: 2018-01-01 to 2026-10-05"
    },
    {
      "dataset": "incidents: flood (MMDA flood reports in the news)",
      "step": "read",
      "in": 75,
      "retained": 75,
      "corrected": 0,
      "removed": 0,
      "note": "56 flooded corners on MMDA's lists (2021 to 2026) and 19 flood days with City of Manila streets named but no single point (2012 to 2024)"
    },
    {
      "dataset": "incidents: flood (MMDA flood reports in the news)",
      "step": "clean",
      "in": 75,
      "retained": 67,
      "corrected": 0,
      "removed": 8,
      "note": "removed: no usable date or coordinates; the same corner twice on one day (within 300 m)",
      "detail": {
        "unusable": 0,
        "duplicates": 8
      }
    },
    {
      "dataset": "incidents: flood (MMDA flood reports in the news)",
      "step": "geocode",
      "in": 67,
      "retained": 66,
      "corrected": 0,
      "removed": 1,
      "note": "each corner was placed where its two streets meet on OpenStreetMap (locate_flood_reports.py) and matched to its barangay here; the flood days without one point stay for the LSTM only",
      "detail": {
        "placed_at_a_corner": 47,
        "no_single_point": 19,
        "outside_the_city": 1
      }
    },
    {
      "dataset": "incidents: flood (MMDA flood reports in the news)",
      "step": "time-align",
      "in": 66,
      "retained": 53,
      "corrected": 0,
      "removed": 13,
      "note": "a flood day already on the corner lists is counted once (corrected: merged into those corners); kept the weather period"
    },
    {
      "dataset": "incidents: flood (DSWD DROMIC weather events)",
      "step": "read",
      "in": 203,
      "retained": 203,
      "corrected": 0,
      "removed": 0,
      "note": "every DROMIC monsoon, typhoon, low pressure, or flooding event not named after another province (collect_dromic.py); the latest report of each was searched for the City of Manila"
    },
    {
      "dataset": "incidents: flood (DSWD DROMIC weather events)",
      "step": "clean",
      "in": 203,
      "retained": 22,
      "corrected": 0,
      "removed": 181,
      "note": "removed: Manila not in the latest report, or the report could not be read (2016 and 2017 reports were Google Docs that no longer open)",
      "detail": {
        "manila_not_named": 139,
        "unread": 42
      }
    },
    {
      "dataset": "incidents: flood (DSWD DROMIC weather events)",
      "step": "geocode",
      "in": 22,
      "retained": 28,
      "corrected": 0,
      "removed": 0,
      "note": "a report that names Manila's affected barangays gives one record per barangay at its centre; the others name only how many barangays were affected: one city-wide record (LSTM only)",
      "detail": {
        "barangay_records": 7,
        "city_wide_events": 21
      }
    },
    {
      "dataset": "incidents: flood (DSWD DROMIC weather events)",
      "step": "time-align",
      "in": 28,
      "retained": 28,
      "corrected": 0,
      "removed": 0,
      "note": "dated by the event's first day as DSWD titled it (the day the monsoon or storm began to affect families); later days of a long event are not marked"
    },
    {
      "dataset": "incidents: flood (news + DROMIC)",
      "step": "merge and time-align",
      "in": 81,
      "retained": 80,
      "corrected": 1,
      "removed": 0,
      "note": "a DROMIC city-wide day already in the news records counts once (corrected: merged); kept 2018-01-01 to 2026-10-05"
    },
    {
      "dataset": "incidents: storm surge",
      "step": "read",
      "in": 0,
      "retained": 0,
      "corrected": 0,
      "removed": 0,
      "note": "no storm surge incident in Manila was found in the news or in DROMIC for these years: the LSTM cannot be trained for it; its map comes from UP NOAH's storm surge zones (noah_barangays.py) instead"
    }
  ],
