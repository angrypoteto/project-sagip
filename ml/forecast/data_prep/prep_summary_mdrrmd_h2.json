{
  "variant": "mdrrmd",
  "data": "MDRRMD's own fire and flood records (given 2026-11-04): fires December 2024 to October 2026, floods June 2025 to October 2026, each with its GPS point; rainfall from ERA5 (Open-Meteo) as the live feed reads it; signals from news and storm tracks. Floods are logged in the rainy months only. See docs/OBJECTIVE-2-RESULTS.md",
  "window_days": 14,
  "horizon_days": 2,
  "split": [
    0.7,
    0.15,
    0.15
  ],
  "features": [
    "rainfall_total_mm",
    "rainfall_max_hourly_mm",
    "typhoon_signal",
    "max_wind_kph",
    "storm_surge_m",
    "prior_day_incidents"
  ],
  "period": [
    "2024-12-01",
    "2026-10-31"
  ],
  "steps": [
    {
      "dataset": "weather: GSMaP rainfall",
      "step": "read",
      "in": 5413,
      "retained": 5333,
      "corrected": 0,
      "removed": 80,
      "note": "days asked for 2012-01-01 to 2026-10-26; JAXA has no file for the removed days"
    },
    {
      "dataset": "weather: GSMaP rainfall",
      "step": "clean",
      "in": 5333,
      "retained": 5318,
      "corrected": 0,
      "removed": 15,
      "note": "removed: a cell with no reading (JAXA's no-data value) or a value outside 0 to 1500 mm",
      "detail": {
        "no_reading": 15,
        "out_of_range": 0
      }
    },
    {
      "dataset": "weather: GSMaP rainfall",
      "step": "time-align",
      "in": 5318,
      "retained": 5318,
      "corrected": 0,
      "removed": 0,
      "note": "GSMaP's day runs 00:00 to 23:59 UTC = 08:00 to 07:59 Manila time (PAGASA's 8 AM rainfall day); kept as the Manila date it starts on (16 of its 24 hours)"
    },
    {
      "dataset": "weather: GSMaP rainfall",
      "step": "keep the period",
      "in": 5318,
      "retained": 669,
      "corrected": 0,
      "removed": 4649,
      "note": "2024-12-01 to 2026-10-31, the days every weather source covers"
    },
    {
      "dataset": "weather: GSMaP rainfall",
      "step": "not used",
      "in": 669,
      "retained": 0,
      "corrected": 0,
      "removed": 669,
      "note": "the recorded variant takes every day's rainfall from ERA5 (Open-Meteo), the source the live forecast reads, so training and live inputs are the same kind of number"
    },
    {
      "dataset": "weather: ERA5 (Open-Meteo)",
      "step": "read and clean",
      "in": 5419,
      "retained": 5419,
      "corrected": 0,
      "removed": 0,
      "note": "already in Manila days (Asia/Manila); wettest hour and highest wind of each day"
    },
    {
      "dataset": "weather: typhoon signals",
      "step": "read",
      "in": 39,
      "retained": 5,
      "corrected": 0,
      "removed": 34,
      "note": "days a PAGASA wind signal was up over Metro Manila, from news reports (incomplete); every other day is written as signal 0; no storm surge height was found for any day"
    },
    {
      "dataset": "weather: typhoon signals",
      "step": "estimate from storm tracks",
      "in": 260,
      "retained": 5,
      "corrected": 0,
      "removed": 0,
      "note": "NOAA IBTrACS tracks give an estimated signal for every day (storm_signal.py; it matches 19 of the 23 news days on the day); each day keeps the higher of the news signal and the estimate. corrected = days given a signal the news did not report, or a higher one",
      "detail": {
        "days_added": 0,
        "days_raised": 0
      }
    },
    {
      "dataset": "weather: daily features",
      "step": "merge and correct",
      "in": 700,
      "retained": 700,
      "corrected": 700,
      "removed": 0,
      "note": "one row for every day of the period; corrected = a day without GSMaP rainfall filled with ERA5's total, or a wettest hour (ERA5) above the day's total (GSMaP) lowered to that total",
      "detail": {
        "filled_from_era5": 700,
        "wettest_hour_capped": 0
      }
    },
    {
      "dataset": "incidents: fire (MDRRMD records)",
      "step": "read",
      "in": 263,
      "retained": 263,
      "corrected": 0,
      "removed": 0,
      "note": "every record in MDRRMD's 2025 and 2026 files (x, y are longitude, latitude)"
    },
    {
      "dataset": "incidents: fire (MDRRMD records)",
      "step": "clean and geocode",
      "in": 263,
      "retained": 262,
      "corrected": 0,
      "removed": 1,
      "note": "removed: no readable date or position; a position outside the City of Manila's barangays",
      "detail": {
        "unreadable": 0,
        "outside_manila": 1
      }
    },
    {
      "dataset": "incidents: fire (MDRRMD records)",
      "step": "merge",
      "in": 262,
      "retained": 258,
      "corrected": 0,
      "removed": 4,
      "note": "records of the same fire on the same day within 300 m are one incident (flood records are monitoring points: one flooded street can be logged several times)"
    },
    {
      "dataset": "incidents: fire (MDRRMD records)",
      "step": "time-align",
      "in": 258,
      "retained": 257,
      "corrected": 0,
      "removed": 1,
      "note": "kept the days MDRRMD logged this hazard: 2024-12-01 to 2026-10-31"
    },
    {
      "dataset": "incidents: flood (MDRRMD records)",
      "step": "read",
      "in": 474,
      "retained": 474,
      "corrected": 0,
      "removed": 0,
      "note": "every record in MDRRMD's 2025 and 2026 files (x, y are longitude, latitude)"
    },
    {
      "dataset": "incidents: flood (MDRRMD records)",
      "step": "clean and geocode",
      "in": 474,
      "retained": 472,
      "corrected": 0,
      "removed": 2,
      "note": "removed: no readable date or position; a position outside the City of Manila's barangays",
      "detail": {
        "unreadable": 0,
        "outside_manila": 2
      }
    },
    {
      "dataset": "incidents: flood (MDRRMD records)",
      "step": "merge",
      "in": 472,
      "retained": 236,
      "corrected": 0,
      "removed": 236,
      "note": "records of the same flood on the same day within 300 m are one incident (flood records are monitoring points: one flooded street can be logged several times)"
    },
    {
      "dataset": "incidents: flood (MDRRMD records)",
      "step": "time-align",
      "in": 236,
      "retained": 236,
      "corrected": 0,
      "removed": 0,
      "note": "kept the days MDRRMD logged this hazard: 2025-06-01 to 2026-10-31"
    },
    {
      "dataset": "incidents: storm surge",
      "step": "read",
      "in": 0,
      "retained": 0,
      "corrected": 0,
      "removed": 0,
      "note": "no storm surge incident in Manila was found in the news or in DROMIC for these years: the LSTM cannot be trained for it; its map comes from UP NOAH's storm surge zones (noah_barangays.py) instead"
    }
  ],
