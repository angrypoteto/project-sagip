# Copy to .env and fill in from Supabase: Project Settings > API Keys.
# Run with: flutter run --dart-define-from-file=.env (in apps/mobile)
# Without these values the app runs on the built-in sample data.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional overrides. Normally leave both empty: the app uses the hotline
# and the gateway SIM number an admin sets on the dashboard's Configuration
# page, and keeps the last copy for when there is no data.
# The gateway SIM is for Tier 2 (an SOS by SMS with signal but no data).
SMS_GATEWAY_NUMBER=
MDRRMD_HOTLINE=
