# Copy to .env and fill in from Supabase: Project Settings > API Keys.
# Run with: flutter run --dart-define-from-file=.env (in apps/mobile)
# Without these values the app runs on the built-in sample data.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional: the MDRRMD gateway SIM for Tier 2 (an SOS by SMS when there is
# signal but no data). Leave empty to keep SOS on the phone until online.
SMS_GATEWAY_NUMBER=
