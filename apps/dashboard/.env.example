# Copy to .env and fill in from Supabase: Project Settings > API Keys.
# Run with: flutter run -d chrome --dart-define-from-file=.env
# Without these values the dashboard runs on the built-in mock data.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The resident web form (lib/main_webform.dart) reads the two values above
# and these optional ones:
# The MDRRMD hotline shown in the "SOS is only in the app" notice.
MDRRMD_HOTLINE=
# Where residents get the app; empty hides the link.
APP_DOWNLOAD_URL=
# false: only numbers that already have an account can sign in (plan Q13).
WEBFORM_REGISTRATION=true
